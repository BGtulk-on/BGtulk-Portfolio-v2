ErrorDocument 400 https://bgtulk.dev/
ErrorDocument 401 https://bgtulk.dev/
ErrorDocument 403 https://bgtulk.dev/
ErrorDocument 404 /404.html
ErrorDocument 503 https://bgtulk.dev/


# dev / unused files that should never be public
<FilesMatch "(^test_frames\.js$|\.zip$)">
    Require all denied
</FilesMatch>

Options -Indexes


# gzip text files
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml
</IfModule>


# caching: html always revalidates, assets are cached
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType text/javascript "access plus 1 day"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>